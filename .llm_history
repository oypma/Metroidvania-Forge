07328, 10, 131072, 1507328, 11, 196608, 1507328, 12, 262144, 1507328, 13, 1, 1572864, 9, 65537, 1572864, 10, 131073, 1572864, 11, 196609, 1572864, 12, 262145, 1572864, 13, 327681, 1572864, 14, 393217, 1572864, 15, 65538, 1638400, 10, 131074, 1638400, 11, 196610, 1638400, 12, 262146, 1638400, 13)\n+\n [sub_resource type=\"TileSetAtlasSource\" id=\"TileSetAtlasSource_fcive\"]\n texture = ExtResource(\"1_uh0r3\")\n texture_region_size = Vector2i(32, 32)\n@@ -1208,3 +1211,4 @@ terrain_set_0/terrain_0/color = Color(0.23841786, 1, 0, 1)\n terrain_set_0/terrain_1/name = \"Stone Terrain\"\n terrain_set_0/terrain_1/color = Color(0.09731817, 0, 1, 1)\n sources/0 = SubResource(\"TileSetAtlasSource_fcive\")\n+pattern_0 = SubResource(\"TileMapPattern_uh0r3\")\ndiff --git a/levels/tutorial/tutorial.tscn b/levels/tutorial/tutorial.tscn\nindex e576048..d09c237 100644\n--- a/levels/tutorial/tutorial.tscn\n+++ b/levels/tutorial/tutorial.tscn\n@@ -48,6 +48,13 @@ offset_bottom = 40.0\n tutorial_text = \"Press Space or Z to jump!\"\n actions_to_press = Array[String]([\"jump\"])\n \n+[node name=\"TutorialNode\" parent=\"TutorialManager\" unique_id=1224654748 instance=ExtResource(\"5_cui05\")]\n+visible = false\n+offset_right = 97.0\n+offset_bottom = 40.0\n+tutorial_text = \"Release jump to get a variable jump height <tab>\"\n+actions_to_press = Array[String]([\"continue\"])\n+\n [node name=\"Crouch\" parent=\"TutorialManager\" unique_id=1828379066 instance=ExtResource(\"5_cui05\")]\n visible = false\n offset_right = 97.0\n@@ -65,9 +72,9 @@ actions_to_press = Array[String]([\"continue\"])\n [node name=\"OneWaySeeThem\" parent=\"TutorialManager\" unique_id=207663242 instance=ExtResource(\"5_cui05\")]\n visible = false\n offset_right = 97.0\n-offset_bottom = 40.0\n-tutorial_text = \"Go to the right to see some of the one way platforms. <tab>\"\n-actions_to_press = Array[String]([\"continue\"])\n+offset_bottom = 42.0\n+tutorial_text = \"Go to the right to see some of the one way platforms. <