; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Metroidvania Forge"
run/main_scene="uid://cilmdg5tpbdkk"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://bn3bmyqingnk6"

[autoload]

SceneManager="*uid://crexy2y1bn4gq"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://00_global/": "pink",
"res://general/": "purple",
"res://levels/": "orange",
"res://materials_and_shaders/": "blue",
"res://player/": "green"
}

